{
  "name": "dm-price-tracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Cloudflare Workers 上で動作するクローラーと管理画面",
  "author": "sui",
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "typescript",
    "pnpm",
    "monorepo"
  ],
  "scripts": {
    "predev": "pnpm run db:migrate:local",
    "dev": "pnpm --parallel --filter www --filter @cf-crawler/mercari-crawler --filter @cf-crawler/duel-masters-official-crawler run dev",
    "dev:www": "pnpm --filter www run dev",
    "dev:mercari-crawler": "pnpm --filter @cf-crawler/mercari-crawler run dev",
    "dev:official-crawler": "pnpm --filter @cf-crawler/duel-masters-official-crawler run dev",
    "crawl:mercari": "curl http://localhost:8787/cdn-cgi/handler/scheduled",
    "db:migrate:local": "pnpm --filter @cf-crawler/mercari-crawler run db:migrate:local && pnpm --filter @cf-crawler/duel-masters-official-crawler run db:migrate",
    "db:migrate:local:display": "pnpm --filter @cf-crawler/mercari-crawler run display-db:migrate",
    "db:migrate:local:mercari": "pnpm --filter @cf-crawler/mercari-crawler run db:migrate",
    "db:migrate:local:official": "pnpm --filter @cf-crawler/duel-masters-official-crawler run db:migrate",
    "deploy:www": "pnpm --filter www run deploy",
    "deploy:mercari-crawler": "pnpm --filter @cf-crawler/mercari-crawler run deploy",
    "deploy:official-crawler": "pnpm --filter @cf-crawler/duel-masters-official-crawler run deploy",
    "format": "biome format --write --reporter=github ./apps ./packages",
    "check": "biome check ./apps ./packages",
    "check:fix": "biome check --write ./apps ./packages",
    "lint": "biome lint ./apps ./packages",
    "lint:unsafe-fix": "biome lint --write --unsafe ./apps ./packages",
    "lint:ai": "biome lint --reporter=github ./apps ./packages",
    "type-check": "pnpm --filter '*' run type-check",
    "type-check:ai": "pnpm --filter '*' run type-check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "ai-check": "pnpm --silent run format && pnpm --silent run lint:ai && pnpm --silent run type-check:ai",
    "similarity": "similarity-ts --exclude node_modules --exclude dist --exclude .astro --exclude changelogs --exclude analysis --exclude inferred --exclude metadata --exclude '*.d.ts' .",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,cjs,mjs,cts,mts,json,jsonc,html,astro}": "biome check --write --no-errors-on-unmatched"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "^4.1.10",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "tsx": "^4.23.1",
    "typescript": "catalog:",
    "vitest": "^4.1.10"
  }
}
