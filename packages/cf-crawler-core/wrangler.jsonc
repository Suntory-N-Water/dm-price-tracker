{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-crawler-core",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-05",
  "compatibility_flags": ["nodejs_compat"],
  "workflows": [
    {
      "name": "cf-crawler-core-orchestrator",
      "binding": "ORCHESTRATOR",
      "class_name": "BaseOrchestrator"
    },
    {
      "name": "cf-crawler-core-job",
      "binding": "JOB_WORKFLOW",
      "class_name": "BaseJob"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cf-crawler-core"
    }
  ],
  "vars": {
    "CHUNK_SIZE": 10,
    "RETRY_LIMIT": 3,
    "POLLING_INTERVAL": "5 seconds"
  }
}
