{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mercari-crawler",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-21",
  "compatibility_flags": ["nodejs_compat"],
  "browser": {
    "binding": "BROWSER"
  },
  "r2_buckets": [
    {
      "binding": "SCREENSHOTS",
      "bucket_name": "mercari-crawler-screenshots"
    },
    {
      "bucket_name": "mercari-crawler-screenshots",
      "binding": "mercari_crawler_screenshots"
    }
  ],
  "triggers": {
    "crons": ["*/30 * * * *"]
  },
  "workflows": [
    {
      "name": "mercari-crawler-orchestrator",
      "binding": "ORCHESTRATOR",
      "class_name": "MercariCrawlerOrchestrator"
    },
    {
      "name": "mercari-crawler-job",
      "binding": "JOB_WORKFLOW",
      "class_name": "MercariCrawlerJob"
    }
  ],
  "vars": {
    "CHUNK_SIZE": 10,
    "RETRY_LIMIT": 3,
    "POLLING_INTERVAL": "5 seconds"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mercari-crawler-db",
      "preview_database_id": "mercari-crawler-db-local",
      "database_id": "f328e20e-e953-46bf-8670-f0b184a2a4c1"
    },
    {
      "binding": "DISPLAY_DB",
      "database_name": "duelmasters-display-db",
      "preview_database_id": "duelmasters-display-db-local",
      "migrations_dir": "./migrations-display-db",
      "database_id": "7edc2cfe-6f98-427f-bb91-feb03638a268"
    }
  ]
}
