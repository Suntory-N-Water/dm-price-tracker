{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dm-price-tracker-api-test",
  "main": "src/test-utils/worker.ts",
  "compatibility_date": "2026-07-23",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "WEB_ORIGIN": "http://web.test"
  },
  "d1_databases": [
    {
      "binding": "DISPLAY_DB",
      "database_name": "duelmasters-display-db-test"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CARD_IMAGES",
      "bucket_name": "duelmasters-card-images-test"
    },
    {
      "binding": "SCREENSHOTS",
      "bucket_name": "mercari-crawler-screenshots-test"
    }
  ]
}
